rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platformRole == 'admin';
    }

    function isOwner(classId) {
      return signedIn()
        && get(/databases/$(database)/documents/classes/$(classId)).data.ownerUid == request.auth.uid;
    }

    function isMember(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.active == true;
    }

    function role(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.role;
    }

    function isTeacher(classId) { return isMember(classId) && role(classId) == 'teacher'; }
    function isBCS(classId) { return isMember(classId) && role(classId) == 'bcs'; }

    function linkedStudentId(classId) {
      return get(/databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid)).data.studentId;
    }

    function isOwnStudent(classId, studentId) {
      return isMember(classId)
        && (role(classId) == 'student' || role(classId) == 'parent')
        && linkedStudentId(classId) == studentId;
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.platformRole == 'user'
        && request.resource.data.active == true;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.platformRole == resource.data.platformRole
        && request.resource.data.active == resource.data.active);
      allow delete: if isAdmin();
    }

    match /classes/{classId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true;
      allow update, delete: if isAdmin() || isOwner(classId) || isTeacher(classId);

      match /members/{uid} {
        allow read: if isAdmin() || isOwner(classId) || isTeacher(classId)
          || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if isAdmin() || isOwner(classId) || isTeacher(classId);
      }

      match /students/{studentId} {
        allow read: if isAdmin() || isTeacher(classId) || isBCS(classId)
          || isOwnStudent(classId, studentId);
        allow write: if isAdmin() || isOwner(classId) || isTeacher(classId);
      }

      match /privateStudentData/{studentId} {
        allow read: if isAdmin() || isTeacher(classId) || isOwnStudent(classId, studentId);
        allow write: if isAdmin() || isOwner(classId) || isTeacher(classId);
      }

      match /transactions/{transactionId} {
        allow read: if isAdmin() || isTeacher(classId) || isBCS(classId)
          || (isMember(classId) && resource.data.studentId == linkedStudentId(classId));
        allow create, update: if isAdmin() || isTeacher(classId) || isBCS(classId);
        allow delete: if isAdmin() || isTeacher(classId);
      }

      match /homeworkTasks/{id} {
        allow read: if isMember(classId) || isAdmin();
        allow write: if isAdmin() || isTeacher(classId) || isBCS(classId);
      }

      match /timetable/{id} {
        allow read: if isMember(classId) || isAdmin();
        allow write: if isAdmin() || isTeacher(classId);
      }

      match /pointRules/{id} {
        allow read: if isMember(classId) || isAdmin();
        allow write: if isAdmin() || isTeacher(classId);
      }

      match /dayLocks/{id} {
        allow read, write: if isTeacher(classId) || isBCS(classId) || isAdmin();
      }

      match /weekLocks/{id} {
        allow read, write: if isTeacher(classId) || isAdmin();
      }

      match /groupBonuses/{id} {
        allow read: if isTeacher(classId) || isBCS(classId) || isAdmin();
        allow write: if isTeacher(classId) || isAdmin();
      }

      match /schoolRankings/{id} {
        allow read: if isTeacher(classId) || isBCS(classId) || isAdmin();
        allow write: if isTeacher(classId) || isAdmin();
      }

      match /cleaningDuties/{id} {
        allow read, write: if isTeacher(classId) || isBCS(classId) || isAdmin();
      }

      match /cleaningAssignments/{id} {
        allow read, write: if isTeacher(classId) || isBCS(classId) || isAdmin();
      }

      match /reminders/{id} {
        allow read, write: if isTeacher(classId) || isBCS(classId) || isAdmin();
      }

      match /auditLogs/{id} {
        allow read: if isTeacher(classId) || isAdmin();
        allow create: if isTeacher(classId) || isBCS(classId) || isAdmin();
        allow update, delete: if false;
      }

      match /settings/{id} {
        allow read, write: if isTeacher(classId) || isOwner(classId) || isAdmin();
      }

      match /{document=**} { allow read, write: if false; }
    }

    match /{document=**} { allow read, write: if false; }
  }
}
