rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function memberPath(classId) { return /databases/$(database)/documents/classes/$(classId)/members/$(request.auth.uid); }
    function activeMember(classId) { return signedIn() && exists(memberPath(classId)) && get(memberPath(classId)).data.active == true; }
    function role(classId) { return get(memberPath(classId)).data.role; }
    function isTeacher(classId) { return activeMember(classId) && (role(classId) == 'teacher' || role(classId) == 'gvcn'); }
    function isBCS(classId) { return activeMember(classId) && role(classId) == 'bcs'; }
    function isParent(classId) { return activeMember(classId) && role(classId) == 'parent'; }
    function ownStudent(classId, studentId) { return isParent(classId) && get(memberPath(classId)).data.studentId == studentId; }
    function validParentView(data) {
      return data.schemaVersion == 1
        && data.classId is string
        && data.studentId is string
        && data.student is map
        && data.transactions is list
        && data.timetable is list
        && data.homeworkTasks is list;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Public parent portal: unauthenticated users may GET one exact document
    // only when they already know its unguessable document ID. Collection
    // listing/querying is always blocked, so a guest cannot enumerate students.
    match /parentViews/{lookupCode} {
      allow get: if true;
      allow list: if false;
      allow create: if validParentView(request.resource.data)
        && isTeacher(request.resource.data.classId);
      allow update: if validParentView(request.resource.data)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.studentId == resource.data.studentId
        && (isTeacher(resource.data.classId) || isBCS(resource.data.classId));
      allow delete: if isTeacher(resource.data.classId);
    }

    match /classes/{classId} {
      allow read: if activeMember(classId);
      allow create, update, delete: if isTeacher(classId);

      match /members/{uid} {
        allow read: if isTeacher(classId) || (signedIn() && request.auth.uid == uid);
        allow create, update, delete: if isTeacher(classId);
      }
      match /parentViewLinks/{studentId} {
        allow read: if isTeacher(classId) || isBCS(classId);
        allow create, update, delete: if isTeacher(classId);
      }
      match /students/{studentId} {
        allow read: if activeMember(classId) && (!isParent(classId) || ownStudent(classId, studentId));
        allow create, update, delete: if isTeacher(classId);
      }
      match /privateStudentData/{studentId} {
        allow read: if isTeacher(classId) || ownStudent(classId, studentId);
        allow create, update, delete: if isTeacher(classId);
      }
      match /transactions/{transactionId} {
        allow read: if activeMember(classId) && (!isParent(classId) || resource.data.studentId == get(memberPath(classId)).data.studentId);
        allow create: if (isTeacher(classId) || isBCS(classId))
          && request.resource.data.studentId is string
          && request.resource.data.studentName is string
          && request.resource.data.studentName.size() > 0;
        allow update: if isTeacher(classId) || isBCS(classId);
        allow delete: if isTeacher(classId) || isBCS(classId);
      }
      match /pointRules/{id} { allow read: if activeMember(classId); allow write: if isTeacher(classId); }
      match /homeworkTasks/{id} { allow read: if activeMember(classId); allow write: if isTeacher(classId) || isBCS(classId); }
      match /timetable/{id} { allow read: if activeMember(classId); allow write: if isTeacher(classId) || isBCS(classId); }
      match /dayLocks/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId) || isBCS(classId); }
      match /weekLocks/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId); }
      match /groupBonuses/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId); }
      match /schoolRankings/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId); }
      match /cleaningDuties/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId) || isBCS(classId); }
      match /cleaningAssignments/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId) || isBCS(classId); }
      match /reminders/{id} { allow read: if activeMember(classId) && !isParent(classId); allow write: if isTeacher(classId) || isBCS(classId); }
      match /auditLogs/{id} {
        allow read: if isTeacher(classId);
        allow create: if isTeacher(classId) || isBCS(classId);
        allow update, delete: if false;
      }
      match /{document=**} { allow read, write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}
